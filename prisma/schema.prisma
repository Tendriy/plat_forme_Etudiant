generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Etudiant {
  id              Int         @id @default(autoincrement())
  prenom          String?     @db.VarChar(150)
  nom             String      @db.VarChar(150)
  email           String @unique      @db.VarChar(200)
  motDePasse      String      @db.VarChar(255)
  dateInscription DateTime    @default(now()) @db.Timestamp(6)
  image           String?     @db.VarChar(250)
  messagesEnvoyes Message[]   @relation("EtudiantMessages")
  messagesRecus    Recevoire[]
  annonces         Annonce[]
  commentaires     Commentaire[]
  signalements     Signaler[]
  accessToken     String?     @db.Text
  refreshToken    String?     @db.Text
  isAuthGoogle    Boolean     @default(false)
  otpCode         String?     @db.VarChar(6)
  otpExpiresAt    DateTime?
  demandesEnvoyees Amitie[]     @relation("DemandesEnvoyees")
  demandesRecues   Amitie[]     @relation("DemandesRecues")
  groupes          EtudiantGroupe[]
  messagesGroupes  MessageGroupe[]
}


model Message {
  id         Int        @id @default(autoincrement())
  contenu    String?    @db.VarChar(150)
  date       DateTime   @default(now()) @db.Timestamp(6)
  etudiantId Int
  etudiant   Etudiant   @relation("EtudiantMessages", fields: [etudiantId], references: [id], onDelete: Cascade)
  receveurs  Recevoire[]
}

model Recevoire {
  etudiantId Int
  messageId  Int
  etudiant   Etudiant  @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  message    Message  @relation(fields: [messageId], references: [id])
  @@id([etudiantId, messageId])
}

model Annonce {
  id                 Int           @id @default(autoincrement())
  titre              String        @db.VarChar(150)
  contenu            String?
  image              String?       @db.VarChar(250)
  dateDePublication  DateTime      @default(now()) @db.Timestamp(6)
  etudiantId         Int?
  auteur             Etudiant?     @relation(fields: [etudiantId], references: [id], onDelete: SetNull)
  commentaires       Commentaire[]
  signalements       Signaler[]
}

model Commentaire {
  id          Int        @id @default(autoincrement())
  date        DateTime   @default(now()) @db.Timestamp(6)
  etudiantId  Int?
  annonceId   Int?
  contenu     String?    @db.Text()
  auteur      Etudiant?  @relation(fields: [etudiantId], references: [id], onDelete: SetNull)
  annonce     Annonce?   @relation(fields: [annonceId], references: [id], onDelete: SetNull)
}

model Signaler {
  annonceId  Int
  etudiantId Int
  annonce    Annonce   @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  etudiant   Etudiant  @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  @@id([annonceId, etudiantId])
}

enum StatutAmitie {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

model Amitie {
  id              Int          @id @default(autoincrement())
  demandeurId      Int
  receveurId       Int
  statut          StatutAmitie @default(EN_ATTENTE)
  dateDemande     DateTime     @default(now())
  dateAcceptation DateTime?

  demandeur        Etudiant      @relation("DemandesEnvoyees", fields: [demandeurId], references: [id], onDelete: Cascade)
  receveur         Etudiant      @relation("DemandesRecues", fields: [receveurId], references: [id], onDelete: Cascade)

  @@unique([demandeurId, receveurId])
}

model Groupe {
  id        Int               @id @default(autoincrement())
  nom       String            @db.VarChar(100)
  membres   EtudiantGroupe[]
  messages  MessageGroupe[]
  createdAt DateTime          @default(now())
}

model EtudiantGroupe {
  etudiantId Int
  groupeId   Int

  etudiant   Etudiant  @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  groupe     Groupe    @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@id([etudiantId, groupeId])
}

model MessageGroupe {
  id        Int       @id @default(autoincrement())
  contenu   String    @db.VarChar(300)
  date      DateTime  @default(now())
  auteurId  Int
  groupeId  Int

  auteur    Etudiant  @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  groupe    Groupe    @relation(fields: [groupeId], references: [id], onDelete: Cascade)
}
